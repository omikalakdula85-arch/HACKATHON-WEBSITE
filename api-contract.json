{
  "contractVersion": "1.0.0",
  "basePath": "/api/v1",
  "authentication": {
    "type": "Bearer",
    "header": "Authorization: Bearer <accessToken>",
    "demoOnly": true,
    "login": {
      "method": "POST",
      "path": "/auth/demo-login",
      "request": {
        "username": "admin@demo.local | driver1@demo.local | citizen@demo.local"
      },
      "response": {
        "accessToken": "opaque expiring token",
        "tokenType": "bearer",
        "user": {
          "id": "uuid",
          "username": "string",
          "displayName": "string",
          "role": "admin | driver | citizen"
        },
        "demoOnly": true
      }
    }
  },
  "roles": {
    "public": ["auth.demo-login"],
    "authenticated": [
      "auth.me",
      "auth.logout",
      "locations.list",
      "vehicles.list",
      "ml.status",
      "llm.status",
      "llm.triage"
    ],
    "citizen": ["citizen.reports.create", "citizen.reports.list", "uploads.read-own"],
    "driver": [
      "driver.route.read",
      "driver.route.start",
      "driver.route.pause",
      "driver.route.speed",
      "driver.route.location",
      "driver.route.stop.complete",
      "uploads.read-assigned"
    ],
    "admin": [
      "admin.overview",
      "admin.reports.list",
      "admin.report.assign",
      "admin.dispatch",
      "admin.vehicle.update",
      "llm.briefing",
      "admin.simulation-events",
      "uploads.read"
    ]
  },
  "endpoints": [
    {
      "id": "auth.me",
      "method": "GET",
      "path": "/auth/me",
      "response": { "user": "User", "demoOnly": true }
    },
    {
      "id": "locations.list",
      "method": "GET",
      "path": "/locations",
      "response": {
        "locations": [
          {
            "id": "string",
            "name": "string",
            "latitude": "number",
            "longitude": "number",
            "fillLevelPercent": "number 0..100",
            "estimatedWasteKg": "number",
            "confidenceRange": ["number", "number"],
            "modelVersion": "string"
          }
        ],
        "modelVersion": "string"
      }
    },
    {
      "id": "vehicles.list",
      "method": "GET",
      "path": "/vehicles",
      "response": {
        "vehicles": [
          {
            "id": "string",
            "name": "string",
            "capacityKg": "number",
            "available": "boolean",
            "driverId": "string|null"
          }
        ]
      }
    },
    {
      "id": "llm.triage",
      "method": "POST",
      "path": "/llm/triage",
      "request": {
        "description": "string, 5..2000 characters",
        "urgency": "low | medium | high"
      },
      "response": {
        "wasteType": "Hazardous | Organic | Recyclable | General",
        "urgency": "low | medium | high",
        "priorityScore": "integer 0..100",
        "estimatedWasteKg": "number 1..500",
        "handlingInstructions": "string",
        "source": "groq | local_rules",
        "warning": "string"
      }
    },
    {
      "id": "citizen.reports.create",
      "method": "POST",
      "path": "/citizen/reports",
      "contentType": "multipart/form-data",
      "request": {
        "description": "string, 5..2000 characters",
        "latitude": "number -90..90",
        "longitude": "number -180..180",
        "address": "string, optional, max 240 characters",
        "urgency": "low | medium | high",
        "photo": "optional JPEG, PNG, WebP or GIF; maximum 5 MiB"
      },
      "response": "Report"
    },
    {
      "id": "citizen.reports.list",
      "method": "GET",
      "path": "/citizen/reports",
      "response": { "reports": ["Report"] }
    },
    {
      "id": "admin.overview",
      "method": "GET",
      "path": "/admin/overview",
      "response": {
        "metrics": {
          "pendingReports": "integer",
          "activeRoutes": "integer",
          "averagePredictedFillPercent": "number"
        },
        "reports": ["Report"],
        "vehicles": ["Vehicle"],
        "routes": ["Route"],
        "locations": ["PredictedLocation"],
        "llm": { "provider": "string", "model": "string", "configured": "boolean" }
      }
    },
    {
      "id": "admin.dispatch",
      "method": "POST",
      "path": "/admin/dispatch",
      "response": {
        "optimization": "Challenge 05 output-contract result",
        "routes": ["Route"],
        "unassignedLocations": ["unserviceable stop with reason"],
        "llmWarnings": ["warning"]
      }
    },
    {
      "id": "admin.report.assign",
      "method": "POST",
      "path": "/admin/reports/{report_id}/assign",
      "request": {
        "vehicleId": "string; vehicle must be available, have a driver, and have enough remaining capacity"
      },
      "response": {
        "report": "Report with Assigned status and estimated ETA",
        "route": "Route; stop inserted into the shortest-distance position on the driver's planned route"
      },
      "errors": {
        "404": "Report or vehicle does not exist",
        "409": "Report is no longer pending, vehicle is unavailable, has no driver, or lacks capacity"
      }
    },
    {
      "id": "admin.vehicle.update",
      "method": "PATCH",
      "path": "/admin/vehicles/{vehicle_id}",
      "request": { "available": "boolean" },
      "response": "Vehicle"
    },
    {
      "id": "llm.briefing",
      "method": "GET",
      "path": "/llm/briefing",
      "response": { "text": "string", "source": "string", "warning": "string" }
    },
    {
      "id": "driver.route.read",
      "method": "GET",
      "path": "/driver/route",
      "response": { "route": "Route|null" }
    },
    {
      "id": "driver.route.start",
      "method": "POST",
      "path": "/driver/route/start",
      "response": { "route": "Route" }
    },
    {
      "id": "driver.route.pause",
      "method": "POST",
      "path": "/driver/route/pause",
      "response": { "route": "Route" }
    },
    {
      "id": "driver.route.speed",
      "method": "POST",
      "path": "/driver/route/speed",
      "request": { "multiplier": "1 | 2 | 5" },
      "response": { "route": "Route" }
    },
    {
      "id": "driver.route.location",
      "method": "POST",
      "path": "/driver/route/location",
      "request": { "latitude": "number -90..90", "longitude": "number -180..180" },
      "response": {
        "currentPosition": { "latitude": "number", "longitude": "number" }
      }
    },
    {
      "id": "driver.route.stop.complete",
      "method": "POST",
      "path": "/driver/route/stops/{stop_id}/complete",
      "behavior": "Only the next ordered stop may be completed.",
      "response": { "route": "Route", "completedStopId": "string" }
    }
  ],
  "objects": {
    "Report": {
      "id": "uuid",
      "description": "string",
      "latitude": "number",
      "longitude": "number",
      "wasteType": "Hazardous | Organic | Recyclable | General",
      "urgency": "low | medium | high",
      "priorityScore": "integer",
      "estimatedWasteKg": "number",
      "status": "Pending | Assigned | En Route | Collected",
      "eta": "string|null",
      "photoUrl": "string|null"
    },
    "Route": {
      "id": "uuid",
      "status": "planned | active | paused | completed | cancelled",
      "distanceKm": "number",
      "durationMinutes": "number",
      "loadUsedKg": "number",
      "loadCapacityKg": "number",
      "utilizationPercent": "number",
      "speedMultiplier": "1 | 2 | 5",
      "stops": ["ordered RouteStop"],
      "waypoints": ["Depot", "ordered stops", "DisposalSite"],
      "aiRouteNotes": "string",
      "aiNotesSource": "string"
    },
    "RouteStop": {
      "id": "uuid",
      "sequenceNumber": "integer, starts at 1",
      "name": "string",
      "latitude": "number",
      "longitude": "number",
      "wasteKg": "number",
      "status": "Pending | En Route | Collected",
      "eta": "HH:MM"
    }
  }
}
